# App
NODE_ENV=development
PORT_API_WEB=3000

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=trazabilidad

# JWT (RS256) - rutas a las llaves PEM
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_EXPIRES_IN=8h

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# WhatsApp Notifier (proveedor externo)
WHATSAPP_API_URL=https://api.whatsapp-provider.com
WHATSAPP_API_TOKEN=
WHATSAPP_SENDER_ID=

# CORS
CORS_ORIGIN=*
