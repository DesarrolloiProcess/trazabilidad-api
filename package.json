{
  "name": "trazabilidad-api",
  "version": "1.0.0",
  "description": "API de trazabilidad de entregas para distribucion farmaceutica (CEDIs)",
  "type": "module",
  "main": "dist/index.js",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "npm run build && drizzle-kit generate",
    "db:migrate": "npm run build && drizzle-kit migrate",
    "db:studio": "npm run build && drizzle-kit studio"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "dotenv-expand": "^11.0.6",
    "drizzle-orm": "^0.36.4",
    "express": "^4.18.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.4",
    "nanoid": "^5.0.7",
    "reflect-metadata": "^0.2.2",
    "uuid": "^9.0.1",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.30",
    "@types/uuid": "^9.0.8",
    "drizzle-kit": "^0.30.1",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2"
  }
}
